{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoeBot",
  "version": "0.7.7",
  "identifier": "com.moebot.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-frontend.mjs",
    "beforeBuildCommand": "node scripts/build-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "category": "Utility",
    "shortDescription": "MoeBot console",
    "longDescription": "Desktop console for MoeBot (猫猫机器人), a Cloudflare-based QQ bot manager.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
